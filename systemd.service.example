# Install only after local verification. Replace /srv/hermes-apps/quoteloop if needed.
[Unit]
Description=QuoteLoop founder pilot
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/hermes-apps/quoteloop
ExecStart=/usr/bin/node /srv/hermes-apps/quoteloop/server.mjs
Environment=NODE_ENV=production
Environment=PORT=18081
Environment=HOST=127.0.0.1
Environment=ADMIN_TOKEN=REPLACE_WITH_A_RANDOM_SECRET
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
