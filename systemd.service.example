# Install only after local verification. Replace /srv/hermes-apps/quoteloop if needed.
[Unit]
Description=QuoteLoop founder pilot
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/hermes-apps/quoteloop
ExecStart=/root/.hermes/node/bin/node /srv/hermes-apps/quoteloop/server.mjs
Environment=NODE_ENV=production
Environment=PORT=18082
Environment=HOST=127.0.0.1
EnvironmentFile=/root/.config/quoteloop.env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
